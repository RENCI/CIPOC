    },
    "text": "The BASEMENT MEMBRANE, a sheet of extracellular material, functions as a filtration barrier and a boundary involved in generating and maintaining tissue structure.",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:corpus_uteri:corpus_uteri:d3",
    "source_doc": "summary_stage_2018",
