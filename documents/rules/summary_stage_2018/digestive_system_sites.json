[
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:d1",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "definition",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "The ascending colon, measuring 15 to 20 cm, begins with the cecum, a 6 to 9 cm pouch that arises at the proximal segment of the right colon at the end of the terminal ileum. It is covered with a visceral peritoneum (serosa) and measures 15 to 20 cm. The ascending colon ends at the hepatic flexure, which transitions the ascending colon into the transverse colon, passing just inferior to the liver and anterior to the duodenum.",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:d2",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "definition",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "The transverse colon, measuring 18 to 22 cm long, is completely intraperitoneal and supported on a mesentery that is attached to the pancreas. Anteriorly the serosa is continuous with the gastrocolic ligament. The transverse colon ends at the splenic flexure, which transitions into the descending colon.",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:d3",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "definition",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "The descending colon, measuring 10 to 15 cm long, passes interiorly to the spleen and anterior to the tail of the pancreas. The posterior aspect lacks serosa and is in direct contact with the retroperitoneum.",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:d4",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "definition",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "The sigmoid colon, measuring 15 to 20 cm long, is completely intraperitoneal with a mesentery that develops at the medial border of the left psoas major muscle and extends to the rectum. The transition from the sigmoid colon to the rectum is marked by the fusion of the taenia of the sigmoid colon to the circumferential muscle of the rectum.",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:d5",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "definition",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "The rectum, measuring 12 to 16 cm, is covered by peritoneum in front and on both sides.",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:d7",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "definition",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "Subserosal tissues include fat and flesh between the muscularis and the serosa.",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:d8",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "definition",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "Serosa is also called mesothelium and visceral peritoneum. For the stomach and small intestine, serosa is also referred to as tunica serosa.",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:i9",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "instruction",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "The term \"serosa\" is sometimes generically used to include both the serosa and the subserosa, and therefore, the clinician should be consulted to determine if the use of \"serosa\" includes the subserosa also.",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:d10",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "definition",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "Mesenteric fat is also called pericolic fat.",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:d11",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "definition",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "The tissue outside the muscularis of the esophagus is composed of fibrous connective tissue and referred to as adventitia.",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:d12",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "definition",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "Anterior and lateral, but not posterior.",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:d13",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "definition",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "Referred to as perirectal tissue.",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:i14",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "instruction",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "Historically, carcinomas described as \"confined to mucosa\" have been assigned 1 (localized). In order to provide greater specificity and to rule out the possibility of classifying noninvasive tumors in this category, abstractors should determine a. If the tumor is confined to the epithelium, in which case it is in situ, OR b. If the tumor has penetrated the basement membrane to invade the lamina propria, in which case it is localized and assigned Summary Stage 1 (localized) for invasion of the lamina propria",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:d15",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "definition",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "The EPITHELIAL LAYER borders on the lumen. It contains no blood vessels or lymphatics.",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:d16",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "definition",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "The BASEMENT MEMBRANE, a sheet of extracellular material, functions as a filtration barrier and a boundary involved in generating and maintaining tissue structure.",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:d17",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "definition",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "The LAMINA PROPRIA, composed of areolar connective tissue, contains blood vessels, nerves, and, in some regions, glands. Once tumor has broken through the basement membrane into the lamina propria, it can spread by way of the lymphatics and blood vessels to other parts of the body.",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:d18",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "definition",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "The MUSCULARIS MUCOSAE is a thin layer of smooth muscle fibers. It is found in the wall of the digestive tract from the esophagus to the anal canal.",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:d19",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "definition",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "The SUBMUCOSA is a thick layer of either dense or areolar connective tissue. It contains blood vessels, lymphatic vessels, nerves, and, in some regions, glands.",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:d20",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "definition",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "The MUSCULARIS PROPRIA is a double layer of muscle tissue in most of the digestive tract; it constitutes the wall of the organ.",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:d21",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "definition",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "The SEROSA, the outermost layer covering most of the digestive tract, is a single layer of squamous epithelial cells, part of the visceral peritoneum.",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:d22",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "definition",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "The SUBSEROSA is inside the serosa (mesothelium), and sometimes part of the serosa. The serosa and subserosa are present only in the peritonealized portions of the digestive tract.",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:d23",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "definition",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "For the esophagus and in the rectum below the peritoneal reflection, there is no serosa.",
    "codes": null,
    "notes": null
  },
  {
    "rule_id": "summary_stage_2018:digestive_system_sites:digestive_system_sites:d24",
    "source_doc": "summary_stage_2018",
    "section_path": [
      "DIGESTIVE AND HEPATOBILIARY SYSTEMS",
      "DIGESTIVE SYSTEM SITES"
    ],
    "anchor": "L4219-L4301:digestive-system-sites",
    "kind": "definition",
    "item_ids": [
      764
    ],
    "applies_to": {
      "sites": null,
      "histologies": null,
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "For the esophagus, the connective tissue of surrounding structures merges with the connective tissue of the esophagus and is called ADVENTITIA.",
    "codes": null,
    "notes": null
  }
]
