        "8982"
      ],
      "behaviors": null,
      "sex": null,
      "dx_date_min": "2018-01-01",
      "dx_date_max": null
    },
    "text": "Contiguous or secondary nodal basins are the next nodal drainage basins beyond the primary nodal basins and are coded as regional nodes.",
    "codes": null,
    "notes": null
  },
